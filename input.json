{
  "outcome": "Interaction_Energy",
  "treatments": ["omega_k_R1", "Charge_Transfer", "alpha_C_C", "beta_C_C", "torsion", "Pyramidal_R1", "Delta_phi"],
  "datasets": [
    {"name": "da-01-BU", "path": "da-01-BU.csv", "temperature_K": 300},
    {"name": "da-02-BU", "path": "da-02-BU.csv", "temperature_K": 300},
    {"name": "da-04-BU", "path": "da-04-BU.csv", "temperature_K": 300}
  ],
  "units": {
    "Interaction_Energy": "eV/atom",
    "omega_k_R1": "eV",
    "Charge_Transfer": "e",
    "alpha_C_C": "angstrom",
    "beta_C_C": "angstrom",
    "torsion": "degree",
    "Pyramidal_R1": "degree",
    "Delta_phi": "degree"
  },
  "graph": {
    "nodes": ["Interaction_Energy", "omega_k_R1", "Charge_Transfer", "alpha_C_C", "beta_C_C", "torsion", "Pyramidal_R1", "Delta_phi"],
    "edges": [
      ["Delta_phi", "alpha_C_C"],
      ["torsion", "alpha_C_C"],
      ["Pyramidal_R1", "alpha_C_C"],
      ["Delta_phi", "beta_C_C"],
      ["torsion", "beta_C_C"],
      ["alpha_C_C", "Charge_Transfer"],
      ["alpha_C_C", "Interaction_Energy"],
      ["beta_C_C", "Charge_Transfer"],
      ["beta_C_C", "Interaction_Energy"],
      ["omega_k_R1", "Charge_Transfer"],
      ["Charge_Transfer", "Interaction_Energy"],
      ["omega_k_R1", "alpha_C_C"]
    ]
  },
  "dml": {
    "method_name": "backdoor.econml.dml.LinearDML",
    "model_y": {
      "n_estimators": 50, "max_depth": 4, "learning_rate": 0.1,
      "random_state": 42, "n_jobs": 1, "force_row_wise": true, "verbose": -1
    },
    "model_t": {
      "n_estimators": 50, "max_depth": 4, "learning_rate": 0.1,
      "random_state": 42, "n_jobs": 1, "force_row_wise": true, "verbose": -1
    },
    "init_params": {"discrete_treatment": false, "random_state": 42, "cv": 2},
    "fit_params": {},
    "estimate_params": {"control_value": 0, "treatment_value": 1, "target_units": "ate"}
  },
  "refuters": {
    "placebo": {
      "method_name": "placebo_treatment_refuter", "placebo_type": "permute",
      "num_simulations": 100, "n_jobs": 1
    },
    "random_refute": {
      "method_name": "random_common_cause",
      "num_simulations": 100, "n_jobs": 1
    }
  },
  "output_dir": "results"
}
